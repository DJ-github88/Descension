# Environment Configuration
NODE_ENV=development

# Allow unverified dev tokens / decoded JWTs for socket auth.
# ONLY for local development. Never set in production; production always
# verifies Firebase ID tokens regardless of this flag.
ALLOW_DEV_AUTH=true

# Token required to access GET /debug/logs (endpoint is disabled without it).
# DEBUG_TOKEN=change-me

# Server Configuration
PORT=3001

# CORS Origins (comma-separated for production)
# Development (default includes localhost:3000 and localhost:3001)
CORS_ORIGIN=http://localhost:3000

# Production (includes both Netlify domains and localhost for local testing)
# Default: https://windtunnel.netlify.app,https://mythrill.netlify.app,http://localhost:3000
# CORS_ORIGIN=https://windtunnel.netlify.app,https://your-custom-domain.com,http://localhost:3000

# Firebase Configuration
# For production, use Firebase service account key JSON as a string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}
FIREBASE_PROJECT_ID=mythrill-ff7c6

# For development, you can use default credentials or set GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Database Configuration (for future use)
# DATABASE_URL=your_database_connection_string

# Optional: Redis Configuration (for scaling)
# REDIS_URL=your_redis_connection_string
