diff --git a/vtt-react/src/components/rules/__tests__/ClassesDisplay.test.jsx b/vtt-react/src/components/rules/__tests__/ClassesDisplay.test.jsx
index 244717b1..8253b806 100644
--- a/vtt-react/src/components/rules/__tests__/ClassesDisplay.test.jsx
+++ b/vtt-react/src/components/rules/__tests__/ClassesDisplay.test.jsx
@@ -21,3 +21,21 @@ test('a catalogue entry opens the requested class through its native button', ()
   fireEvent.click(screen.getByRole('button', { name: 'Explore Berserker' }));
   expect(onSelectClass).toHaveBeenCalledWith('Berserker');
 });
+
+test('the preview entry opens the workshop and back returns to the catalogue', () => {
+  render(<ClassesDisplay onSelectClass={jest.fn()} />);
+  expect(screen.getByText(/Reconstruction preview/)).toBeTruthy();
+  fireEvent.click(screen.getByRole('button', { name: 'Open class workshop' }));
+  expect(screen.getByRole('heading', { level: 2, name: 'Chaos Weaver' })).toBeTruthy();
+  expect(screen.queryByRole('button', { name: 'Explore Berserker' })).toBeNull();
+  fireEvent.click(screen.getByRole('button', { name: /Back to classes/ }));
+  expect(screen.getByRole('button', { name: 'Explore Berserker' })).toBeTruthy();
+});
+
+test('the preview entry leaves the original class click callback untouched', () => {
+  const onSelectClass = jest.fn();
+  render(<ClassesDisplay onSelectClass={onSelectClass} />);
+  fireEvent.click(screen.getByRole('button', { name: 'Explore Berserker' }));
+  expect(onSelectClass).toHaveBeenCalledWith('Berserker');
+  expect(onSelectClass).toHaveBeenCalledTimes(1);
+});
