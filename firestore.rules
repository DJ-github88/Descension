rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Project 4 C5: room authority coordination is server/Admin only. No
    // browser/client SDK access to lease records or tombstones.
    match /roomAuthorities/{roomId} {
      allow read, write: if false;
    }

    // Project 4 C3: durable membership-compensation obligations (failed
    // invitation rollbacks awaiting corrective removal) are server/Admin only.
    // No browser/client SDK access.
    match /membershipCompensations/{compensationId} {
      allow read, write: if false;
    }

    // Project 4 H2: durable room access requires a normal non-anonymous account.
    function isDurableAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isUltimateTier(userId) {
      return request.auth != null &&
        request.auth.uid == userId &&
        get(/databases/$(database)/documents/users/$(userId)).data.subscriptionTier in [
          'ultimate', 'mythic', 'dev_preview', 'demiurge', 'sovereign', 'premium',
          'ULTIMATE', 'MYTHIC', 'DEV_PREVIEW', 'DEMIURGE', 'SOVEREIGN', 'PREMIUM'
        ];
    }

    // Users can read their own user document.
    // Project 4: the public projection lives at userProfiles/{uid}; protected
    // fields cannot be added, changed or deleted by omission from a client.
    match /users/{userId} {
      function protectedFieldUnchanged(key) {
        return (!(key in request.resource.data) && !(key in resource.data))
          || ((key in request.resource.data) && (key in resource.data)
              && request.resource.data[key] == resource.data[key]);
      }
      function protectedFieldsUnchanged() {
        return protectedFieldUnchanged('subscriptionTier')
          && protectedFieldUnchanged('subscriptionUpdatedAt')
          && protectedFieldUnchanged('isGuest')
          && protectedFieldUnchanged('admin')
          && protectedFieldUnchanged('role')
          && protectedFieldUnchanged('cleanupAssets');
      }
      function mutableFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'friendId', 'friendId_lowercase',
          'createdAt', 'lastLoginAt', 'characters', 'preferences', 'gameData',
          'storageUsage', 'hasProfile', 'profileLastUpdated', 'profile',
          'version', 'updatedAt'
        ]);
      }

      function initialFieldsOnly() {
        return request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'friendId', 'friendId_lowercase',
          'createdAt', 'lastLoginAt', 'characters', 'preferences', 'gameData',
          'storageUsage', 'hasProfile', 'profileLastUpdated', 'profile',
          'version', 'updatedAt'
        ]);
      }

      allow read: if isSignedIn() && request.auth.uid == userId;
      // Positive allowlist: unknown/internal/protected fields (including any
      // privilege or billing field) are denied on create.
      allow create: if isSignedIn() && request.auth.uid == userId
        && initialFieldsOnly();
      allow update: if isSignedIn() && request.auth.uid == userId
        && protectedFieldsUnchanged()
        && mutableFieldsOnly();
      // Account deletion is a separate policy outside Project 4.
      allow delete: if false;
    }

    // ===== PRESENCE TRACKING =====
    // User presence for online/offline status and session tracking
    match /presence/{userId} {
      // Allow reading for authenticated users (to see who's online)
      allow read: if request.auth != null;
      // Allow users to write their own presence
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== SOCIAL DATA =====
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.receiverId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (request.auth.uid == resource.data.senderId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId
      );
    }

    // ===== CHARACTER DATA PERSISTENCE =====
    // Users can read/write their own characters (stored in top-level characters collection)
    // SECURITY: read is allowed for the owner; create requires the userId to match.
    // The combined `read, write` rule below is split into separate read/create/update
    // so that missing documents (no resource.data) don't trigger permission errors
    // during getDoc() calls on non-existent character IDs.
    match /characters/{characterId} {
      function ownerIsCaller() {
        return isSignedIn() && resource != null
          && resource.data.metadata.userId == request.auth.uid;
      }
      function cleanupDescriptorUnchanged() {
        return (!('cleanupAssets' in request.resource.data) && !('cleanupAssets' in resource.data))
          || (('cleanupAssets' in request.resource.data) && ('cleanupAssets' in resource.data)
              && request.resource.data.cleanupAssets == resource.data.cleanupAssets);
      }

      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.metadata.userId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.metadata.userId == request.auth.uid
        && !('cleanupAssets' in request.resource.data);
      // Ownership is immutable to ordinary clients; the cleanup descriptor is
      // Admin-only.
      allow update: if ownerIsCaller()
        && request.resource.data.metadata.userId == resource.data.metadata.userId
        && cleanupDescriptorUnchanged();
      allow delete: if ownerIsCaller();
    }

    // Character runtime state (HP, inventory, equipment, etc.)
    match /users/{userId}/characterStates/{characterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Character sessions for tracking gameplay changes
    // (top-level `characterSessions` collection — actual collection name used in code)
    match /characterSessions/{sessionId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Legacy snake_case collection kept for backwards compatibility.
    match /character_sessions/{sessionId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Character backup snapshots — owner only
    match /character_backups/{backupId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // ===== ROOM DATA PERSISTENCE (PROJECT 4 ACCESS BOUNDARY) =====
    // Raw room roots and every canonical checkpoint fragment are server/Admin
    // resources. The server mediates safe draft creation (checking that no
    // root or fragment already exists at the id), every authorized read and
    // every mutation. Clients never read or write this collection directly,
    // which also prevents a new draft from claiming orphaned legacy state.
    match /rooms/{roomId} {
      allow read, write: if false;

      match /gameState/{documentId} {
        allow read, write: if false;
      }

      match /chat/{documentId} {
        allow read, write: if false;
      }
    }

    // Room runtime state (tokens, items, environmental objects, combat, chat)
    match /users/{userId}/roomStates/{roomId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Room sessions for active multiplayer sessions (owner only)
    match /roomSessions/{sessionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ===== JOURNAL DATA PERSISTENCE =====
    // User journals (knowledge, notes, boards, folders)
    match /users/{userId}/journal/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== WORLDBUILDING PERSISTENCE =====
    // User worldbuilding (books, interactive maps, family trees, lineages, factions, timelines, quests)
    match /users/{userId}/worldbuilding/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== USER TOOL STATE =====
    // Spellbook (windowed spell manager) and action-bar layouts, owner only.
    match /users/{userId}/spellbook/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/actionBar/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== CAMPAIGN DATA PERSISTENCE =====
    // User campaigns (GM planning data)
    match /users/{userId}/campaigns/{campaignId=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== COMMUNITY CONTENT =====

    // Shared campaigns - published campaigns for download (Archmage tier)
    match /sharedCampaigns/{campaignId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.publisherId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.publisherId ||
        request.resource.data.keys().hasOnly(['downloads'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.publisherId;

      // Full campaign gameState lives in a subcollection doc so browse lists
      // never download it. Only the publisher may write.
      match /data/{documentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/sharedCampaigns/$(campaignId)).data.publisherId;
      }
    }

    // Public game data (items, spells, etc.) - read only
    match /gameData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Community spells - allow public read access
    match /community_spells/{spellId} {
      allow read: if resource.data.isPublic == true;
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.authorId ||
        request.resource.data.authorId == 'seed-system'
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount', 'downloadCount', 'upvotes', 'downvotes'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        resource.data.authorId == 'seed-system'
      );
    }

    // Spell categories - PUBLIC READ / ADMIN WRITE ONLY (Project 4)
    match /spell_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Spell ratings - public read (the client recalculates averages by querying
    // all ratings for a spell), owner create/update/delete.
    match /spell_ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // Community items - public read is limited to published items. The previous
    // `allow read: if true` combined with the client's unfiltered fallback
    // query exposed private drafts in the public feed.
    match /community_items/{itemId} {
      allow read: if resource.data.isPublic == true;
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.authorId
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.authorId || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'commentCount', 'downloadCount', 'rating', 'ratingCount'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId
      );
    }

    // Item categories - PUBLIC READ / ADMIN WRITE ONLY (Project 4)
    match /item_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Item ratings - public read, owner create/update/delete.
    // Doc convention: {itemId}_{userId}; docs also carry a userId field so we
    // never parse the id (Firestore rules have no endsWith()).
    match /item_ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // Item comments - public read; create must be attributed to the author
    match /item_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Community creatures - allow public read access
    match /community_creatures/{creatureId} {
      allow read: if resource.data.isPublic == true;
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.authorId
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount', 'downloadCount'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId
      );
    }

    // Creature categories - PUBLIC READ / ADMIN WRITE ONLY (Project 4)
    match /creature_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Creature ratings - public read, owner create/update/delete.
    match /creature_ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // Community packs - allow public read access
    match /community_packs/{packId} {
      allow read: if resource.data.isPublic == true;
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.authorId
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount', 'downloadCount', 'version', 'changelog'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId
      );
    }

    // Pack ratings - public read, owner create/update/delete.
    match /pack_ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // ===== CONTENT MODERATION =====
    // Any authenticated user may file a report. Reviewing/actioning reports and
    // editing the word filter are moderator functions gated on the `admin`
    // custom claim. Grant it via the Admin SDK, e.g.:
    //   admin.auth().setCustomUserClaims(uid, { admin: true })
    // (the user must refresh their ID token afterwards).
    match /contentReports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.reporterId;
    }

    match /moderationActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // The word filter is read publicly (clients run local filtering) but may
    // only be edited by moderators.
    match /filteredWords/{wordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Spell favorites - previously had no rule block at all (default deny), so
    // favoriting silently failed. Doc id convention: {spellId}_{userId}.
    match /spell_favorites/{favoriteId} {
      allow read: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Community maps - public read for published maps, owner-managed otherwise.
    // Uploads store `originalUserId` (the client strips `userId`), so ownership
    // accepts userId/authorId/originalUserId for compatibility.
    match /community_maps/{mapId} {
      allow read: if resource.data.isPublic == true ||
        (request.auth != null && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == resource.data.originalUserId
        ));
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.authorId ||
        request.auth.uid == request.resource.data.originalUserId
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        request.auth.uid == resource.data.originalUserId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'rating', 'ratingCount'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        request.auth.uid == resource.data.originalUserId
      );
    }

    // Map categories - PUBLIC READ / ADMIN WRITE ONLY (Project 4)
    match /map_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Map ratings - public read, owner create/update/delete.
    match /map_ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // Lightweight feed summaries - public read, owner writes.
    // Feed lists query this shallow collection instead of downloading full
    // stat blocks / nested configs; the full entity is fetched on demand.
    match /community_summaries/{summaryId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // ===== CHAT RATE LIMITING =====
    // Timestamp-comparison write cooldown. Clients send chat through a batch
    // that (a) updates chat_cooldowns/{uid}.lastMessageAt and (b) creates the
    // message. Rules evaluate both writes against the pre-batch cooldown doc,
    // so a second send inside the window is rejected server-side.
    match /chat_cooldowns/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.time >= resource.data.lastMessageAt + duration.value(1, 's');
    }

    match /globalChat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && (
          !exists(/databases/$(database)/documents/chat_cooldowns/$(request.auth.uid))
          || request.time >= get(/databases/$(database)/documents/chat_cooldowns/$(request.auth.uid)).data.lastMessageAt + duration.value(1, 's')
        );
      allow update, delete: if false;
    }

    // ===== USER LIBRARIES =====
    // User libraries - allow users to manage their own libraries
    match /users/{userId}/libraries/{libraryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Top-level user library documents (per-user downloaded items/creatures/packs)
    // used by userLibraryService.js — doc id is the userId
    match /user_libraries/{userId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // User library folders (folder structure for organizing user content)
    // used by userSpellService.js — docs carry a userId field
    match /user_folders/{folderId} {
      allow read: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // User audio library (uploaded tracks / YouTube tracks) — owner only
    match /users/{userId}/audio/{trackId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User audio playlists — owner only
    match /users/{userId}/audioPlaylists/{playlistId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User custom spells - allow users to manage their own spells
    match /user_spells/{spellId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // User custom items - allow users to manage their own items
    match /userItems/{itemId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // User item folders - allow users to manage their own item folders
    match /userItemFolders/{folderId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // ===== USER SETTINGS =====
    // User settings and preferences - allow users to manage their own settings
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== USER CREATURES =====
    // User custom creatures - allow users to manage their own creatures
    match /userCreatures/{creatureId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // User creature folders - allow users to manage their own creature folders
    match /userCreatureFolders/{folderId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // ===== USER MAPS =====
    // User custom maps - Archmage/Ultimate users only
    match /userMaps/{mapId} {
      allow read: if request.auth != null && (resource == null || isUltimateTier(resource.data.userId));
      allow create: if isUltimateTier(request.resource.data.userId);
      allow update, delete: if isUltimateTier(resource.data.userId);
    }

    // User map folders - Archmage/Ultimate users only
    match /userMapFolders/{folderId} {
      allow read: if request.auth != null && (resource == null || isUltimateTier(resource.data.userId));
      allow create: if isUltimateTier(request.resource.data.userId);
      allow update, delete: if isUltimateTier(resource.data.userId);
    }

    // Immersive custom-map workspace - Archmage/Ultimate users only.
    // Project 4: the Admin cleanup descriptor is not client-mutable.
    match /userCustomMaps/{userId}/maps/{mapId} {
      allow read: if isUltimateTier(userId);
      allow create: if isUltimateTier(userId)
        && !('cleanupAssets' in request.resource.data);
      allow update: if isUltimateTier(userId)
        && ((!('cleanupAssets' in request.resource.data) && !('cleanupAssets' in resource.data))
            || (('cleanupAssets' in request.resource.data) && ('cleanupAssets' in resource.data)
                && request.resource.data.cleanupAssets == resource.data.cleanupAssets));
      allow delete: if isUltimateTier(userId);
    }

    // ===== INTERACTIVE MAP ANNOTATIONS =====
    // Player pins drawn on the immersive world map. Owner-only.
    match /userMapAnnotations/{userId}/pins/{pinId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Player areas/routes drawn on the immersive world map. Owner-only.
    match /userMapAnnotations/{userId}/areas/{areaId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared map views (24h expiring). Read is recipient-only so the pending
    // inbox query (toUserId == uid) stays provably safe; single-doc update/
    // delete is allowed for both sender and recipient.
    match /mapShares/{shareId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.toUserId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }

    // ===== DICE ROLL HISTORY =====
    // Dice rolls - allow users to manage their own roll history
    match /diceRolls/{rollId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Character roll statistics - owner read/update/delete. Create must be
    // separate because resource.data is invalid on a non-existent doc.
    match /characterRollStats/{statsId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // User custom rollable tables - owner only. Docs carry a userId field and
    // the client list query filters where('userId','==',uid).
    match /customRollableTables/{tableId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Roll sessions - owner (or room GM) only
    match /rollSessions/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.gmId == request.auth.uid
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.gmId == request.auth.uid
      );
    }

    // ===== USER PROFILES =====
    // Project 4 public projection allowlist. Rich private profile data lives
    // owner-only at userSettings/{uid}.profile. Foreign readers may only read
    // version-1 slim projections; legacy mixed documents are not public.
    match /userProfiles/{userId} {
      function slimFieldsOnly(data) {
        return data.keys().hasOnly([
          'displayName', 'photoURL', 'friendId', 'friendId_lowercase',
          'updatedAt', 'projectionVersion'
        ]);
      }
      function nullableString(data, key, max) {
        return !(key in data)
          || data[key] == null
          || (data[key] is string && data[key].size() <= max);
      }
      function friendIdConsistent(data) {
        return (!('friendId' in data) && !('friendId_lowercase' in data))
          || (data.friendId == null && data.friendId_lowercase == null)
          || (data.friendId is string
              && data.friendId_lowercase is string
              && data.friendId_lowercase == data.friendId.lower());
      }
      function validSlimProfile(data) {
        return data.projectionVersion == 1
          && slimFieldsOnly(data)
          && nullableString(data, 'displayName', 100)
          && nullableString(data, 'photoURL', 2048)
          && nullableString(data, 'friendId', 64)
          && nullableString(data, 'friendId_lowercase', 64)
          && friendIdConsistent(data)
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
      }
      // Foreign reads require a truly slim version-1 projection.
      function isPublicProjection() {
        return resource != null && validSlimProfile(resource.data);
      }

      allow read: if isSignedIn() && (
        request.auth.uid == userId || isPublicProjection()
      );
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && validSlimProfile(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Friend lists (doc id = userId), used by persistenceService during
    // account deletion.
    match /friendLists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== LEGACY SUPPORT =====
    // Legacy support for characters stored under users subcollection (if any exist)
    match /users/{userId}/characters/{characterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
