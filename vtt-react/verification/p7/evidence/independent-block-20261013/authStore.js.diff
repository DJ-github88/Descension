+/**
+ * Quota-safe persistence for the admin dev-login session.
+ * localStorage can be full (large map/book/asset caches). A full quota must
+ * never block sign-in, so fall back to sessionStorage (survives refresh in
+ * the same tab) and finally to in-memory only.
+ */
+const adminSessionMemory = {};
+const adminStorageSet = (key, value) => {
+  try {
+    localStorage.setItem(key, value);
+    try { sessionStorage.removeItem(key); } catch (_) { /* ignore */ }
+    return;
+  } catch (err) {
+    console.warn('[auth] localStorage unavailable/full for', key, '- using sessionStorage fallback');
+  }
+  try {
+    sessionStorage.setItem(key, value);
+  } catch (_) {
+    adminSessionMemory[key] = value;
+  }
+};
+const adminStorageGet = (key) => {
+  try {
+    const v = localStorage.getItem(key);
+    if (v !== null) return v;
+  } catch (_) { /* ignore */ }
+  try {
+    const v = sessionStorage.getItem(key);
+    if (v !== null) return v;
+  } catch (_) { /* ignore */ }
+  return adminSessionMemory[key] ?? null;
+};
+const adminStorageRemove = (key) => {
+  try { localStorage.removeItem(key); } catch (_) { /* ignore */ }
+  try { sessionStorage.removeItem(key); } catch (_) { /* ignore */ }
+  delete adminSessionMemory[key];
+};
+
